# Ledgera frontend environment variables.
# Copy to `.env.local` and fill in real values. Next.js picks up NEXT_PUBLIC_*
# at build time and inlines them into the client bundle — do not put secrets here.

# Backend API base URL. Defaults to http://localhost:8000 if unset.
NEXT_PUBLIC_API_URL=https://your-backend-url.railway.app

# Firebase web SDK config (used for client-side auth).
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef1234567890
