# Ledgera backend environment variables.
# Copy to `.env` and fill in real values. Loaded by config/settings.py.

# --- Required ---

# Generate a strong secret. Rotating invalidates all sessions.
JWT_SECRET=your-secret-here

# Comma-separated frontend origins allowed via CORS.
# Required in prod/preview (Railway). Localhost default only applies if unset.
ALLOWED_ORIGINS=https://your-frontend-url.railway.app,https://your-custom-domain.com

# --- Optional (with sensible defaults) ---

# Defaults to sqlite:///./ledgera.db for local. Set to a Postgres URL in prod.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/ledgera

# Raw JSON string of the Firebase service account credentials. Required in
# prod/preview. Local dev may leave this unset and drop
# `firebase-service-account.json` in the repo root as a fallback.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# JWT_ALGORITHM=HS256
# JWT_EXPIRY_HOURS=24

# API_HOST=0.0.0.0
# API_PORT=8000
# API_DEBUG=false

# PRICE_PROVIDER=yahoo_finance
# PRICE_CACHE_TTL=3600

# BASE_CURRENCY=SGD

# --- Observability (optional, no-op when unset) ---

# Sentry DSN for backend error tracking. Leave blank to disable Sentry entirely.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
